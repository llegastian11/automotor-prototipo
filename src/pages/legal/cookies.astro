---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { withBase } from '../../utils/url';
---

<BaseLayout title="Política de cookies | Automotor.pe" description="Política de cookies de Automotor.pe, pendiente de revisión y aprobación legal." noindex>
  <section class="section legal-page">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Legal', href: '/legal/cookies/' }, { label: 'Política de cookies', href: '/legal/cookies/' }]} />
      <div class="legal-box">
        <p class="eyebrow">Información legal</p>
        <h1 class="section-title">Política de cookies</h1>
        <p>Contenido provisional pendiente de revisión y aprobación legal. Esta ruta está preparada para incorporar el documento definitivo.</p>
        <a class="btn btn-outline" href={withBase('/')}>Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page { min-height: calc(100vh - 94px); }
  .legal-box { max-width: 820px; padding: 30px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); }
  .legal-box p { margin: 16px 0 24px; color: var(--muted); line-height: 1.75; }
</style>
