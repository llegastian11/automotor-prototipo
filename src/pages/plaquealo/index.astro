---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlateForm from '../../components/PlateForm.astro';
import { withBase } from '../../utils/url';
---

<BaseLayout
  title="Plaquéalo | Reporte vehicular por placa en Perú"
  description="Genera un reporte vehicular con antecedentes, documentos y alertas organizadas a partir de una sola placa."
>
  <section class="home-overview">
    <div class="container home-overview-grid">
      <div class="home-overview-copy">
        <p class="eyebrow">Plaquealo · reporte vehicular</p>
        <h1 class="section-title">Una placa. La información clave en un solo reporte.</h1>
        <p class="section-copy">Plaquealo organiza antecedentes, documentos y alertas para ayudarte a revisar un vehículo antes de comprarlo o venderlo.</p>
        <div class="home-service-list" aria-label="Información incluida en Plaquealo">
          <a href={withBase('/consulta-vehicular/')}><span>01</span><div><strong>Antecedentes y documentos</strong><small>Propiedad, multas, SOAT, revisión técnica y más.</small></div><b>→</b></a>
          <a href={withBase('/consulta-vehicular/')}><span>02</span><div><strong>Alertas fáciles de interpretar</strong><small>Resultados organizados por estado y nivel de atención.</small></div><b>→</b></a>
          <a href={withBase('/consulta-vehicular/')}><span>03</span><div><strong>25 fuentes disponibles</strong><small>Información pública y especializada reunida en una lectura.</small></div><b>→</b></a>
        </div>
      </div>
      <article class="home-plaquealo-card">
        <div class="home-plaquealo-content">
          <span class="product-label">Consulta Plaquealo</span>
          <h2>La placa cuenta la historia.</h2>
          <p>Ingresa una placa, elige el reporte que necesitas y continúa con la consulta.</p>
          <PlateForm id="plaquealoPlate" label="Ingresa la placa del vehículo" />
          <fieldset class="report-products" id="reportProducts">
            <legend>Elige tu reporte</legend>
            <label class="report-product selected"><input type="radio" name="reportProduct" value="completo" data-price="35" checked /><span class="report-product-check" aria-hidden="true"></span><span class="report-product-copy"><strong>Reporte completo</strong><small>Antecedentes, documentos, alertas y estado vehicular.</small></span><b>S/ 35</b></label>
            <label class="report-product"><input type="radio" name="reportProduct" value="propietarios" data-price="20" /><span class="report-product-check" aria-hidden="true"></span><span class="report-product-copy"><strong>Reporte de propietarios</strong><small>Historial de propietarios registrados del vehículo.</small></span><b>S/ 20</b></label>
            <label class="report-product"><input type="radio" name="reportProduct" value="papeletas" data-price="15" /><span class="report-product-check" aria-hidden="true"></span><span class="report-product-copy"><strong>Reporte de papeletas a nivel nacional</strong><small>Consulta de papeletas disponibles en distintas regiones del Perú.</small></span><b>S/ 15</b></label>
          </fieldset>
          <button class="report-product-cta" id="reportProductCta" type="button" disabled>Continuar con reporte completo · S/ 35</button>
          <p class="report-product-note">Precio referencial · Reporte digital preparado para descargar</p>
        </div>
        <div class="home-plaquealo-art"><img src={withBase('/assets/automotor/paisaje-automotor-hd.webp')} alt="Automóvil recorriendo un paisaje peruano" width="900" height="600" /></div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .home-overview { padding: 92px 0 80px; }
  .home-overview-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr); gap: 72px; align-items: start; }
  .home-overview-copy .section-title { max-width: 650px; font-size: clamp(2.65rem, 4.5vw, 4.35rem); }
  .home-service-list { display: grid; margin-top: 36px; border-top: 1px solid var(--line); }
  .home-service-list a { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 15px; padding: 18px 4px; border-bottom: 1px solid var(--line); transition: padding 0.18s ease, color 0.18s ease; }
  .home-service-list a:hover { padding-left: 10px; color: var(--red); }
  .home-service-list a > span { font: 700 10px var(--font-mono); color: var(--red); }
  .home-service-list strong, .home-service-list small { display: block; }
  .home-service-list strong { font-size: 14px; }
  .home-service-list small { margin-top: 4px; color: var(--muted); font-size: 11px; }
  .home-service-list b { font-size: 18px; }

  .home-plaquealo-card { position: relative; display: grid; grid-template-rows: auto minmax(280px, 1fr); overflow: hidden; border: 1px solid rgba(23, 23, 25, 0.12); border-radius: 25px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .home-plaquealo-content { z-index: 1; margin: 18px 18px 0; padding: 25px 26px 22px; border: 1px solid rgba(23, 23, 25, 0.1); border-radius: 18px; background: #fffdfa; }
  .home-plaquealo-content h2 { margin: 0; max-width: 420px; font: 700 clamp(1.65rem, 2.5vw, 2.15rem) / 1.08 var(--font-display); }
  .home-plaquealo-content p { margin: 10px 0 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
  .home-plaquealo-content :global(.plate-form) { margin-top: 20px; }
  .home-plaquealo-content :global(.plate) { height: 62px; grid-template-columns: 58px minmax(0, 1fr) 126px; }
  .home-plaquealo-content :global(.plate-input) { font-size: clamp(1.2rem, 2.2vw, 1.65rem); }
  .home-plaquealo-art { min-height: 310px; margin-top: 16px; }
  .home-plaquealo-art img { width: 100%; height: 100%; object-fit: cover; }

  .report-products { display: grid; gap: 8px; margin: 22px 0 0; padding: 0; border: 0; }
  .report-products legend { padding: 0; margin-bottom: 4px; font-size: 11px; font-weight: 700; color: var(--muted); }
  .report-product { position: relative; display: grid; grid-template-columns: 20px 1fr auto; align-items: center; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; }
  .report-product input { position: absolute; opacity: 0; }
  .report-product-check { display: grid; width: 18px; height: 18px; border: 2px solid var(--line); border-radius: 50%; place-items: center; }
  .report-product-check::after { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--red); opacity: 0; }
  .report-product.selected { border-color: var(--red); background: var(--red-light); }
  .report-product.selected .report-product-check { border-color: var(--red); }
  .report-product.selected .report-product-check::after { opacity: 1; }
  .report-product-copy strong { display: block; font-size: 13px; }
  .report-product-copy small { display: block; margin-top: 2px; color: var(--muted); font-size: 11px; }
  .report-product > b { font-size: 13px; font-weight: 800; }

  .report-product-cta { display: block; width: 100%; margin-top: 18px; min-height: 48px; border: 0; border-radius: 12px; background: var(--red); color: #fff; font-weight: 700; cursor: pointer; }
  .report-product-cta:disabled { background: var(--line); color: var(--muted); cursor: not-allowed; }
  .report-product-note { margin: 10px 0 0 !important; font-size: 11px; color: var(--muted); }

  @media (max-width: 980px) {
    .home-overview { padding: 76px 0; }
    .home-overview-grid { grid-template-columns: 1fr; gap: 42px; }
    .home-plaquealo-art { min-height: 330px; }
  }
  @media (max-width: 680px) {
    .home-overview { padding: 58px 0 64px; }
    .home-plaquealo-content { margin: 18px 12px 0; padding: 20px; }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const plate = params.get('placa');
  if (plate) {
    const input = document.getElementById('plaquealoPlateInput') as HTMLInputElement | null;
    if (input) { input.value = plate; input.dispatchEvent(new Event('input')); }
  }

  const cta = document.getElementById('reportProductCta') as HTMLButtonElement | null;
  const names: Record<string, string> = { completo: 'reporte completo', propietarios: 'reporte de propietarios', papeletas: 'reporte de papeletas nacional' };
  document.querySelectorAll<HTMLInputElement>('input[name="reportProduct"]').forEach((input) => {
    input.addEventListener('change', () => {
      document.querySelectorAll('.report-product').forEach((option) => option.classList.toggle('selected', option.contains(input)));
      if (cta) cta.textContent = `Continuar con ${names[input.value]} · S/ ${input.dataset.price}`;
    });
  });

  const plateInput = document.getElementById('plaquealoPlateInput') as HTMLInputElement | null;
  cta?.addEventListener('click', () => {
    const value = (plateInput?.value || '').replace('-', '');
    if (value.length < 6) plateInput?.focus();
  });

  plateInput?.addEventListener('input', () => {
    if (cta) cta.disabled = plateInput.value.replace('-', '').length < 6;
  });
</script>
