---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Descargar TIVE en Perú | Automotor.pe"
  description="Solicita la Tarjeta de Identificación Vehicular Electrónica (TIVE) verificando los datos del titular."
>
  <section class="section tive-page">
    <div class="container tive-layout">
      <div>
        <p class="eyebrow">Documento vehicular</p>
        <h1 class="section-title">Descarga tu TIVE.</h1>
        <p class="section-copy">Solicita la Tarjeta de Identificación Vehicular Electrónica con los datos del titular.</p>
        <div class="tive-note">Costo referencial del servicio <strong>S/ 20</strong></div>
      </div>
      <form class="quote-card" id="tiveForm" novalidate>
        <h2>Datos para la solicitud</h2>
        <p>Verifica que el DNI corresponda al titular del vehículo.</p>
        <div class="quote-grid">
          <div class="quote-field full"><label for="tiveDni">DNI del titular</label><input id="tiveDni" inputmode="numeric" maxlength="8" placeholder="12345678" required /></div>
          <div class="quote-field full"><label for="tivePlate">Placa del vehículo</label><input id="tivePlate" maxlength="8" placeholder="ABC-123" required /></div>
          <button class="btn btn-red" type="submit">Solicitar TIVE</button>
        </div>
        <p class="quote-feedback" id="tiveFeedback" role="status">Solicitud demostrativa; no se realizará ningún cargo.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .tive-page { min-height: calc(100vh - 94px); background: linear-gradient(145deg, #fff, var(--paper)); }
  .tive-layout { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 72px; align-items: start; }
  .tive-note { display: flex; align-items: center; justify-content: space-between; max-width: 460px; margin-top: 30px; padding: 17px 19px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); font-size: 13px; }
  .tive-note strong { color: var(--red); font: 700 22px var(--font-display); }

  .quote-card { padding: 30px; border: 1px solid var(--line); border-radius: 22px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .quote-card h2 { margin: 0; font: 700 24px var(--font-display); }
  .quote-card > p { margin: 9px 0 25px; color: var(--muted); line-height: 1.55; }
  .quote-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .quote-field label { font-size: 12px; font-weight: 700; }
  .quote-field input { height: 50px; border: 1px solid var(--line); border-radius: 11px; background: #fff; padding: 0 14px; width: 100%; margin-top: 7px; }
  .quote-feedback { margin: 14px 0 0; color: var(--muted); font-size: 12px; }

  @media (max-width: 980px) { .tive-layout { grid-template-columns: 1fr; gap: 34px; } }
</style>

<script>
  const dni = document.getElementById('tiveDni') as HTMLInputElement | null;
  const plate = document.getElementById('tivePlate') as HTMLInputElement | null;
  const form = document.getElementById('tiveForm') as HTMLFormElement | null;
  const feedback = document.getElementById('tiveFeedback');

  dni?.addEventListener('input', () => { dni.value = dni.value.replace(/\D/g, '').slice(0, 8); });
  plate?.addEventListener('input', () => { plate.value = plate.value.toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 8); });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!feedback || !dni || !plate) return;
    if (dni.value.length !== 8 || plate.value.replace('-', '').length < 6) {
      feedback.textContent = 'Completa el DNI de 8 dígitos y una placa válida.';
      feedback.style.color = 'var(--danger)';
      return;
    }
    feedback.textContent = `Solicitud preparada para ${plate.value}. Es una demostración; no se realizará ningún cargo.`;
    feedback.style.color = 'var(--green)';
  });
</script>
