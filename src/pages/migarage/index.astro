---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';

const features = [
  { num: '01', title: 'Multas y SOAT', text: 'Nuevas deudas, papeletas y próximos vencimientos.' },
  { num: '02', title: 'Duplicado de placas', text: 'Seguimiento de movimientos asociados al duplicado de una placa.' },
  { num: '03', title: 'Garantía vehicular', text: 'Alertas para revisar cambios relevantes en la garantía.' },
  { num: '04', title: 'Órdenes de embargo', text: 'Monitoreo de registros que requieren atención del propietario.' },
];
---

<BaseLayout
  title="MiGarage | Alertas vehiculares en Perú | Automotor.pe"
  description="MiGarage vigila los vehículos que ya tienes: multas, SOAT, embargos y duplicados de placa en un solo lugar."
>
  <section class="section garage-page">
    <div class="container">
      <p class="eyebrow">MiGarage</p>
      <h1 class="section-title">Tus vehículos, siempre vigilados.</h1>
      <p class="section-copy">Recibe alertas sobre cambios importantes vinculados a tus vehículos.</p>
      <div class="garage-features">
        {features.map((feature) => (
          <article><b>{feature.num}</b><h2>{feature.title}</h2><p>{feature.text}</p></article>
        ))}
      </div>
      <a class="btn btn-red" href={withBase('/planes/')}>Ver planes</a>
    </div>
  </section>
</BaseLayout>

<style>
  .garage-page { min-height: calc(100vh - 94px); background: linear-gradient(145deg, #fff, var(--paper)); }
  .garage-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 42px 0 30px; }
  .garage-features article { padding: 27px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .garage-features b { color: var(--red); font: 700 10px var(--font-mono); }
  .garage-features h2 { margin: 18px 0 8px; font: 700 19px var(--font-display); }
  .garage-features p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }

  @media (max-width: 980px) { .garage-features { grid-template-columns: 1fr; } }
</style>
