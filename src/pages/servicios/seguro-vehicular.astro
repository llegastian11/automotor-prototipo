---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceQuoteForm from '../../components/ServiceQuoteForm.astro';
import { services } from '../../data/services';

const service = services.find((item) => item.key === 'seguro-vehicular')!;
---

<BaseLayout title={`${service.title} | Automotor.pe`} description={service.description}>
  <section class="section service-page">
    <div class="container service-layout">
      <div class="service-copy">
        <Breadcrumbs items={[{ label: 'Otros servicios', href: '/consulta-vehicular/' }, { label: service.name, href: `/${service.route}/` }]} />
        <p class="eyebrow">Servicios PLAQUÉALO</p>
        <h1 class="section-title">{service.title}</h1>
        <p class="section-copy">{service.description}</p>
        <ul class="service-benefits">{service.benefits.map((item) => <li>{item}</li>)}</ul>
        <div class="service-partners">
          <span>Trabajamos con</span>
          <div>{service.partners.map((partner) => <strong>{partner}</strong>)}</div>
          <p>{service.partnersNote}</p>
        </div>
      </div>
      <ServiceQuoteForm service={service} />
    </div>
  </section>
</BaseLayout>

<style>
  .service-page { min-height: calc(100vh - 76px); background: linear-gradient(145deg, var(--paper), #fff); }
  .service-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 70px; align-items: start; }
  .service-copy { position: sticky; top: 110px; }
  .service-benefits { display: grid; gap: 12px; margin: 30px 0 0; padding: 0; list-style: none; }
  .service-benefits li { display: flex; gap: 10px; color: var(--muted); }
  .service-benefits li::before { content: '✓'; color: var(--green); font-weight: 800; }
  .service-partners { margin-top: 30px; padding: 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .service-partners > span { display: block; margin-bottom: 12px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .service-partners > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .service-partners strong { padding: 8px 11px; border-radius: 8px; background: var(--surface-secondary); font-size: 12px; }
  .service-partners p { margin: 14px 0 0; color: var(--muted); font-size: 11px; line-height: 1.5; }

  @media (max-width: 980px) {
    .service-layout { grid-template-columns: 1fr; gap: 38px; }
    .service-copy { position: static; }
  }
</style>
