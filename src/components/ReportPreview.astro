---
const topics = [
  { key: 'multas', label: 'Multas', status: 'Sin registro', attention: false, source: 'Consulta SAT y municipalidades', detail: 'No se encontraron papeletas en la vista de ejemplo.' },
  { key: 'soat', label: 'SOAT', status: 'Vigente', attention: false, source: 'Consulta APESEG', detail: 'La póliza figura vigente en la vista de ejemplo.' },
  { key: 'gravamenes', label: 'Gravámenes', status: '1 registro', attention: true, source: 'Consulta SUNARP', detail: 'Se encontró un registro que conviene revisar antes de comprar.' },
];
---

<article class="hero-report-card" aria-label="Vista previa interactiva del reporte vehicular">
  <div class="hero-report-head">
    <div><small>Vista previa del reporte</small><strong id="previewPlate">ABC-123</strong></div>
    <span>PE</span>
  </div>
  <div class="hero-report-options" role="list">
    {topics.map((topic, index) => (
      <button
        class:list={['hero-report-row', { selected: index === 0, attention: topic.attention }]}
        type="button"
        data-topic={topic.key}
        data-source={topic.source}
        data-detail={topic.detail}
        aria-expanded={index === 0 ? 'true' : 'false'}
      >
        <i>{topic.attention ? '!' : '✓'}</i><span>{topic.label}</span><b>{topic.status}</b>
      </button>
    ))}
  </div>
  <div class="report-insight" id="reportInsight" aria-live="polite">
    <span>{topics[0].source}</span>
    <p>{topics[0].detail}</p>
  </div>
</article>

<style>
  .hero-report-card {
    position: relative;
    display: grid;
    grid-template-columns: 160px 1fr minmax(170px, 0.8fr);
    gap: 12px;
    align-items: center;
    width: 100%;
    padding: 15px 17px;
    border: 1px solid rgba(23, 23, 25, 0.1);
    border-radius: 18px;
    background: rgba(255, 253, 250, 0.97);
    box-shadow: 0 12px 28px rgba(23, 23, 25, 0.08);
  }
  .hero-report-head { display: flex; flex-direction: column; justify-content: center; padding: 0 14px 0 0; border-right: 1px solid var(--line); }
  .hero-report-head small { display: block; margin-bottom: 6px; color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
  .hero-report-head strong { font: 700 19px var(--font-mono); letter-spacing: 0.09em; }
  .hero-report-head span { display: inline-block; margin-top: 8px; padding: 5px 7px; border-radius: 7px; background: var(--ink); color: #fff; font-size: 9px; font-weight: 800; width: fit-content; }

  .hero-report-options { display: grid; gap: 2px; }
  .hero-report-row {
    display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 9px;
    width: 100%; min-height: 46px; padding: 10px 9px;
    border: 1px solid transparent; border-radius: 10px; background: transparent;
    color: var(--ink); font: inherit; text-align: left; cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .hero-report-row:hover { background: #f6f2ee; }
  .hero-report-row.selected { border-color: #ded7d0; background: #f7f3ef; }
  .hero-report-row.attention { background: #fff8eb; }
  .hero-report-row.attention:hover, .hero-report-row.attention.selected { border-color: #efd59e; background: #fff3dc; }
  .hero-report-row i { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 50%; background: #e9f7ee; color: var(--green); font-style: normal; font-size: 11px; font-weight: 800; }
  .hero-report-row.attention i { background: #fff0d0; color: var(--amber); }
  .hero-report-row span { font-size: 12px; font-weight: 700; }
  .hero-report-row b { color: var(--green); font-size: 10px; }
  .hero-report-row.attention b { color: var(--amber); }

  .report-insight { margin-top: 0; padding: 11px 12px; border-left: 3px solid var(--danger); border-radius: 4px 9px 9px 4px; background: #f4f1ed; grid-column: 1 / -1; }
  .report-insight span { display: block; margin-bottom: 3px; color: var(--ink); font-size: 9px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .report-insight p { margin: 0; color: var(--muted); font-size: 10px; line-height: 1.45; }

  @media (max-width: 680px) {
    .hero-report-card { grid-template-columns: 1fr; padding: 13px; }
    .hero-report-head { border-right: 0; border-bottom: 1px solid var(--line); padding: 0 0 10px; flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-topic]');
  const insight = document.getElementById('reportInsight');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((item) => {
        item.classList.toggle('selected', item === button);
        item.setAttribute('aria-expanded', item === button ? 'true' : 'false');
      });
      if (insight) {
        insight.innerHTML = `<span>${button.dataset.source}</span><p>${button.dataset.detail}</p>`;
      }
    });
  });
</script>
