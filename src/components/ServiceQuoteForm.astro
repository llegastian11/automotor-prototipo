---
import { company } from '../data/company';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}
const { service } = Astro.props;
const hasWhatsapp = Boolean(company.contact.whatsapp);
---

<form class="quote-card" data-service={service.key} data-service-name={service.name} data-whatsapp={company.contact.whatsapp} novalidate>
  <h2>Solicita tu cotización por WhatsApp</h2>
  <p>Completa los datos y un asesor te responderá con el siguiente paso.</p>
  <div class="quote-grid">
    <div class="quote-field">
      <label for={`${service.key}-plate`}>Número de placa *</label>
      <input id={`${service.key}-plate`} name="plate" placeholder="Ej: ABC-123" maxlength="8" autocomplete="off" />
      <span class="field-error" data-error="plate"></span>
    </div>
    <div class="quote-field">
      <label for={`${service.key}-place`}>Lugar donde circulará *</label>
      <input id={`${service.key}-place`} name="place" placeholder="Ej: Lima, Callao, Arequipa" autocomplete="address-level1" />
      <span class="field-error" data-error="place"></span>
    </div>
    <div class="quote-field full">
      <label for={`${service.key}-document`}>DNI o RUC *</label>
      <input id={`${service.key}-document`} name="document" inputmode="numeric" pattern="[0-9]*" maxlength="11" placeholder="Ej: DNI o RUC" />
      <span class="field-error" data-error="document"></span>
    </div>
    <fieldset class="usage-group">
      <legend>Tipo de uso *</legend>
      <div class="usage-options">
        <div class="radio-card"><input id={`${service.key}-particular`} name="usage" type="radio" value="Particular" /><label for={`${service.key}-particular`}>Particular</label></div>
        <div class="radio-card"><input id={`${service.key}-taxi`} name="usage" type="radio" value="Taxi" /><label for={`${service.key}-taxi`}>Taxi</label></div>
      </div>
      <span class="field-error" data-error="usage"></span>
    </fieldset>
    <button class="btn btn-red" type="submit">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4A8 8 0 1 1 20 11.6Z"/><path d="M9 8.5c.5 2.7 2 4.2 4.7 5"/></svg>
      Enviar por WhatsApp
    </button>
  </div>
  <p class="quote-note">Tus datos solo se usarán para responder esta solicitud.</p>
  <p class="quote-feedback" role="status">{!hasWhatsapp && 'Formulario listo · falta configurar el WhatsApp de contacto.'}</p>
</form>

<style>
  .quote-card { padding: 30px; border: 1px solid var(--line); border-radius: 22px; background: var(--surface); box-shadow: var(--shadow-soft); }
  .quote-card h2 { margin: 0; font: 700 24px var(--font-display); }
  .quote-card > p { margin: 9px 0 25px; color: var(--muted); line-height: 1.55; }
  .quote-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .quote-field { display: grid; gap: 7px; }
  .quote-field.full { grid-column: 1 / -1; }
  .quote-field label, .usage-group legend { font-size: 12px; font-weight: 700; }
  .quote-field input { height: 50px; border: 1px solid var(--line); border-radius: 11px; background: #fff; padding: 0 14px; }
  .quote-field input[aria-invalid='true'] { border-color: var(--danger); }
  .field-error { min-height: 16px; display: block; color: var(--danger); font-size: 11px; }
  .usage-group { grid-column: 1 / -1; border: 0; padding: 0; margin: 0; }
  .usage-options { display: flex; gap: 10px; margin-top: 8px; }
  .radio-card { position: relative; flex: 1; }
  .radio-card input { position: absolute; opacity: 0; }
  .radio-card label { display: flex; align-items: center; justify-content: center; min-height: 50px; border: 1px solid var(--line); border-radius: 11px; background: #fff; cursor: pointer; }
  .radio-card input:checked + label { border-color: var(--red); background: var(--red-light); color: var(--red); }
  .quote-grid .btn { grid-column: 1 / -1; }
  .quote-note { margin: 14px 0 0 !important; font-size: 11px; color: var(--muted); }
  .quote-feedback { margin: 12px 0 0; color: var(--danger); font-size: 12px; min-height: 14px; }

  @media (max-width: 680px) {
    .quote-card { padding: 20px; }
    .quote-grid { grid-template-columns: 1fr; }
    .quote-field.full, .usage-group, .quote-grid .btn { grid-column: auto; }
    .usage-options { display: grid; grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.quote-card').forEach((form) => {
    form.querySelectorAll<HTMLInputElement>('input[name="document"]').forEach((input) => {
      input.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 11); });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const values = Object.fromEntries(data) as Record<string, string>;
      const errors: Record<string, string> = {};

      values.plate = (values.plate || '').toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 8);
      if (values.plate.replace('-', '').length < 6) errors.plate = 'Ingresa una placa válida.';
      if (!(values.place || '').trim()) errors.place = 'Indica dónde circulará el vehículo.';
      if (!/^(\d{8}|\d{11})$/.test(values.document || '')) errors.document = 'Ingresa un DNI de 8 o RUC de 11 dígitos.';
      if (!values.usage) errors.usage = 'Selecciona el tipo de uso.';

      form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => {
        el.textContent = errors[el.dataset.error || ''] || '';
      });
      form.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.setAttribute('aria-invalid', String(Boolean(errors[input.name])));
      });
      if (Object.keys(errors).length) return;

      const serviceName = form.dataset.serviceName;
      const whatsapp = form.dataset.whatsapp;
      const feedback = form.querySelector<HTMLElement>('.quote-feedback');
      const message = `Hola, deseo solicitar una cotización de ${serviceName}.\n\nPlaca: ${values.plate}\nLugar donde circulará: ${values.place}\nDNI/RUC: ${values.document}\nTipo de uso: ${values.usage}\n\nQuisiera recibir información sobre la cotización.`;

      if (!whatsapp) {
        if (feedback) feedback.textContent = 'Formulario validado. Falta configurar el WhatsApp de contacto.';
        return;
      }
      window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      if (feedback) { feedback.textContent = 'Abrimos WhatsApp con tu solicitud lista para enviar.'; feedback.style.color = 'var(--green)'; }
    });
  });
</script>
