---
interface Props {
  label?: string;
}
const { label = 'Ejemplo · contenido ilustrativo' } = Astro.props;
---

<span class="example-badge">{label}</span>

<style>
  .example-badge {
    display: inline-flex;
    margin-top: 12px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--surface-secondary);
    color: var(--muted);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
