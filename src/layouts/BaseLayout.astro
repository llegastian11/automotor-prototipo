---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import PublishModal from '../components/PublishModal.astro';
import { company } from '../data/company';
import { withBase } from '../utils/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Oculta header/footer/CTA flotantes para páginas de utilidad. */
  bare?: boolean;
}

const { title, description, ogImage, noindex, bare = false } = Astro.props;

const siteUrl = String(Astro.site).replace(/\/$/, '');
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.brand,
  legalName: company.legalName,
  taxID: company.ruc,
  url: siteUrl + import.meta.env.BASE_URL,
  logo: siteUrl + import.meta.env.BASE_URL + 'assets/automotor/logo-automotor-oficial.png',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: `+${company.contact.whatsapp}`,
      email: company.contact.email,
      areaServed: 'PE',
      availableLanguage: 'Spanish',
    },
  ],
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.brand,
  url: siteUrl + import.meta.env.BASE_URL,
  inLanguage: 'es-PE',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon" type="image/png" href={withBase('/favicon-32.png')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/favicon-512.png')} sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <SEO title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&family=Sora:wght@700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {!bare && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <WhatsAppFab />}
    {!bare && <PublishModal />}

    <script>
      import { legacyRouteMap } from '../utils/legacyRoutes';

      const hash = window.location.hash;
      if (hash.startsWith('#/')) {
        const route = hash.slice(2).replace(/\/$/, '');
        const target = legacyRouteMap[route];
        if (target) {
          const base = import.meta.env.BASE_URL;
          window.location.replace(`${base}${target.replace(/^\//, '')}${window.location.search}`);
        }
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  main { padding-top: 94px; }
  @media (max-width: 980px) { main { padding-top: 84px; } }
  @media (max-width: 680px) { main { padding-top: 76px; } }
</style>
